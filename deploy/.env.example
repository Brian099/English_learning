# 复制为 .env 后修改。注意 fnOS 上路径通常是 /vol1/<用户id>/...

# 视频根目录（宿主机路径）。容器内挂到 /media，只读。
# 例：/vol1/1000/media/english-kids
MEDIA_ROOT=/vol1/1000/media/english-kids

# 宿主机暴露端口（交给已有的反向代理去反代）
HTTP_PORT=18080

# 默认 SQLite，数据库文件落在 deploy/data/sqlite/kids.db
# 注意：这个目录必须是 NAS 本地盘，不要放到 SMB/NFS 共享上（会锁不住）
# 想换 Postgres 时改成：
# DATABASE_URL=postgresql+asyncpg://kids:密码@db:5432/kids
DATABASE_URL=sqlite+aiosqlite:////data/kids.db

# 媒体文件由谁发送：
#   accel  = 交给前置 nginx 直出（生产默认，API 几乎不耗 CPU）
#   direct = FastAPI 自己按 Range 流式返回（没有 nginx 时用，本地调试用这个）
SERVE_MEDIA=accel

# 签发家长登录令牌用，随便一串 64 位随机字符
APP_SECRET=请改成一长串随机字符

# 家长端登录密码
PARENT_PASSWORD=请改成你的密码

TZ=Asia/Shanghai
