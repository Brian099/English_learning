# 统一换行符：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# 明确的文本类型
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.conf  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
